{
  "name": "cooperadora-hospital1",
  "version": "1.34.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev:backend": "pnpm --filter cooperadora-backend dev",
    "dev:frontend": "pnpm --filter cooperadora-frontend dev",
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "test:backend": "pnpm --filter cooperadora-backend test",
    "test:frontend": "pnpm --filter cooperadora-frontend test",
    "test": "pnpm test:frontend",
    "lint": "pnpm --filter cooperadora-frontend lint",
    "type-check": "pnpm --filter cooperadora-frontend type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
